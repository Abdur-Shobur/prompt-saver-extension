# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name (optional)
MONGODB_DB=prompt_saver

# Long random secret — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Set to false after you create your account to block new sign-ups
ALLOW_REGISTER=true

# Port for local run (node index.js)
PORT=3000
